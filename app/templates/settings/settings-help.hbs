<div class="settings__content">
    <h1><i class="fa fa-question settings__head-icon"></i> {{res 'help'}}</h1>
    <h2>{{res 'setHelpFormat'}}</h2>
    <p>{{#res 'setHelpFormatBody'}}<a href="https://keepass.info/" target="_blank">KeePass</a>{{/res}}</p>
    <h2>{{res 'setHelpProblems'}}</h2>
    <p>{{#res 'setHelpProblems1'}} <a href="{{issueLink}}" target="_blank">{{res 'setHelpOpenIssue'}}</a>{{/res}}
        {{#res 'setHelpProblems2'}}<a href="mailto:wangyantsing@qq.com">{{res 'setHelpContactLink'}}</a>{{/res}}.
    </p>
    <p>{{res 'setHelpAppInfo'}}:</p>
    <pre class="settings__pre input-base">{{appInfo}}</pre>
    <h2>{{res 'setHelpSupport'}}</h2>
    <p>{{res 'setHelpSupportBody'}}</p>
    <div class="settings__donate">
        <figure class="settings__donate-item">
            <img src="img/reward-qr.jpg" alt="{{res 'setHelpRewardQr'}}" />
            <figcaption>{{res 'setHelpRewardQr'}}</figcaption>
        </figure>
        <figure class="settings__donate-item">
            <img src="img/wechat-official.jpg" alt="{{res 'setHelpWechatOfficial'}}" />
            <figcaption>{{res 'setHelpWechatOfficial'}}</figcaption>
        </figure>
    </div>
    <p>{{res 'setHelpContact'}}: <a href="mailto:wangyantsing@qq.com">wangyantsing@qq.com</a></p>
</div>
