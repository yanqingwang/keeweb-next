  "scripts": {
    "start": "grunt",
    "lint": "grunt eslint",
    "test": "cross-env NODE_OPTIONS=--openssl-legacy-provider grunt test",
    "build-beta": "cross-env NODE_OPTIONS=--openssl-legacy-provider grunt --beta && cp dist/index.html ../keeweb-beta/index.html && cd ../keeweb-beta && git add index.html && git commit -a -m 'beta' && git push origin master",
    "dev": "grunt dev",
    "dev-legacy": "cross-env NODE_OPTIONS='--openssl-legacy-provider' grunt dev",
    "babel-helpers": "babel-external-helpers -l 'slicedToArray,toConsumableArray,defineProperty,typeof' -t global > app/lib/babel-helpers.js",
    "set-legacy": "export NODE_OPTIONS=--openssl-legacy-provider",
    "tauri": "tauri",
    "build:web": "cross-env NODE_OPTIONS=--openssl-legacy-provider grunt build-web-app",
    "build:shell": "tauri build",
    "dev:shell": "tauri dev"
  },
  "author": {
    "name": "Antelle",
    "email": "antelle.net@gmail.com",
    "url": "https://antelle.net"
  },
  "engines": {
    "node": ">=10.0"
