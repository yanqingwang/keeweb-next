# Maintainer: yanqingwang
pkgname=keeweb-next
pkgver=0.1.0
pkgrel=1
pkgdesc='KeeWeb as a web app, with an optional Tauri webview shell (WebDAV without CORS limits)'
arch=('x86_64' 'aarch64')
url='https://github.com/yanqingwang/keeweb-next'
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3')
makedepends=('git' 'rust' 'nodejs' 'npm' 'clang' 'cmake' 'ninja' 'pkgconf')
backup=('etc/keeweb-next/config.json')
options=('!lto')
source=("$pkgname::git+https://github.com/yanqingwang/keeweb-next.git")
sha256sums=('SKIP')

build() {
    cd "$pkgname"

    npm_config_userconfig=/dev/null \
    npm_config_allow_git=all \
    npm_config_allow_remote=all \
        npm ci --allow-git=all --allow-remote=all
    npm run build:web

    cd src-tauri
    cargo build --release
}

package() {
    cd "$pkgname"

    # the binary embeds the web assets (frontendDist); the dist copy is kept
    # for the browser mode (keeweb-next-browser)
    install -d "$pkgdir/usr/share/keeweb-next"
    cp -a dist "$pkgdir/usr/share/keeweb-next/dist"

    install -Dm755 src-tauri/target/release/keeweb-next \
        "$pkgdir/usr/bin/keeweb-next"

    # desktop application integration
    install -Dm644 packaging/arch/keeweb-next.desktop \
        "$pkgdir/usr/share/applications/keeweb-next.desktop"
    install -Dm644 src-tauri/icons/128x128.png \
        "$pkgdir/usr/share/icons/hicolor/128x128/apps/keeweb-next.png"
    install -Dm644 src-tauri/icons/32x32.png \
        "$pkgdir/usr/share/icons/hicolor/32x32/apps/keeweb-next.png"
    install -Dm644 src-tauri/icons/512x512.png \
        "$pkgdir/usr/share/icons/hicolor/512x512/apps/keeweb-next.png"

    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
