{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KeeWeb Next",
  "version": "0.1.0",
  "identifier": "info.keeweb.next",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8085"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "KeeWeb Next",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": null
    },
    "enable-gtk-app-id": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/512x512.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}